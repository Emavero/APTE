# ============================================================================
# Backend APTE — copier en .env et adapter. Ne jamais versionner le .env réel.
# ============================================================================

# ------------------------------------------------------------------- Django
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changez-moi-en-production
DJANGO_SETTINGS_MODULE=backendapte.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Africa/Dakar

# ---------------------------------------------------------- Base de données
# Laisser POSTGRES_DB vide pour retomber sur SQLite (pratique hors Docker).
POSTGRES_DB=apte
POSTGRES_USER=apte
POSTGRES_PASSWORD=apte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----------------------------------------------------------------- Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------------- JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ------------------------------------------------------------- Facturation
BILLING_CURRENCY=XOF
BILLING_CURRENCY_SYMBOL=FCFA
# Le XOF n'a pas de sous-unité : 0 décimale.
BILLING_CURRENCY_DECIMAL_PLACES=0
# Taux de TVA (0.18 = 18 %). Les prix catalogue étant TTC, la TVA est extraite
# du total : changer ce taux ne modifie pas le montant payé par le client.
BILLING_TAX_RATE=0.18
BILLING_PRICES_INCLUDE_TAX=True
BILLING_INVOICE_PREFIX=APTE
BILLING_INVOICE_DUE_DAYS=0
BILLING_FREE_SHIPPING=True
BILLING_SHIPPING_FLAT_FEE=0

# --------------------------------------------- Mentions légales de la facture
COMPANY_NAME=APTE
COMPANY_LEGAL_NAME=APTE SARL
COMPANY_ADDRESS=Dakar, Sénégal
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_TAX_ID=
COMPANY_TRADE_REGISTER=

# ------------------------------------------------------------ Paiement Wave
WAVE_API_URL=https://api.wave.com/v1
WAVE_API_KEY=
# Secret de signature des webhooks. Sans lui, les callbacks sont REFUSÉS :
# accepter un webhook non signé permettrait de marquer une commande payée
# sans règlement.
WAVE_WEBHOOK_SECRET=
WAVE_REQUIRE_SIGNED_WEBHOOK=True

# ------------------------------------------------------------------- E-mail
# console = affichage dans les logs (développement).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@apte.local

# --------------------------------------------------------- Limitation de débit
THROTTLE_AUTH=10/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_CHECKOUT=30/hour
THROTTLE_WEBHOOK=120/min
